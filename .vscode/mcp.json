{
  "servers": {
    "sql-mcp-server": {
      "type": "stdio",
      "command": "dotnet",
      "args": [
        "dab",
        "start",
        "--mcp-stdio",
        "role:anonymous",
        "--LogLevel",
        "Error",
        "--config",
        "${workspaceFolder}/dab-config.json"
      ],
      "cwd": "${workspaceFolder}",
      "envFile": "${workspaceFolder}/.env"
    }
  }
}